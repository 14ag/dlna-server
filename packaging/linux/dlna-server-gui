#!/bin/sh
set -eu

# WSLg uses this wrapper as the Start Menu target so it can prepare the
# display and session bus before starting the native GTK application.

resolve_script_dir() {
    dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || dir=""
    if [ -n "$dir" ] && [ -x "$dir/dlna-server-gui-bin" ]; then
        printf '%s\n' "$dir"
        return 0
    fi
    # a desktop entry launcher can invoke this script indirectly so
    # resolving the script directory from the invoking path above
    # can point at the wrong place fall back to known install
    # prefixes before giving up entirely
    for candidate in /usr/bin /usr/local/bin; do
        if [ -x "$candidate/dlna-server-gui-bin" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dlna-server"
log_file="$log_dir/gui-launch.log"
mkdir -p "$log_dir" 2>/dev/null || true

script_dir=$(resolve_script_dir) || {
    {
        echo "dlna-server-gui failed to resolve its own install directory"
        echo "invoking path was $0"
    } >> "$log_file" 2>/dev/null
    echo "DLNA Server could not locate dlna-server-gui-bin" >&2
    exit 1
}

server_bin=${DLNA_SERVER_BIN:-"$script_dir/dlna-server"}
native_gui=${DLNA_SERVER_GUI_BIN:-"$script_dir/dlna-server-gui-bin"}

export DLNA_SERVER_BIN="$server_bin"

if [ ! -x "$native_gui" ]; then
    {
        echo "DLNA Server native GUI is missing or not executable: $native_gui"
    } >> "$log_file" 2>/dev/null
    echo "DLNA Server native GUI is missing or not executable: $native_gui" >&2
    echo "Rebuild with -DDLNA_ENABLE_GTK4_GUI=ON." >&2
    exit 1
fi

# options that never open a window must not wait for a compositor
for arg in "$@"; do
    case "$arg" in
        --help|--kill-server|-k) exec "$native_gui" "$@" ;;
    esac
done

# WSLg shortcuts run in a non login shell so the distro profile may not
# inject these variables yet fall back to the documented WSLg default paths
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "/mnt/wslg/runtime-dir/wayland-0" ]; then
    export WAYLAND_DISPLAY=wayland-0
    export XDG_RUNTIME_DIR="/mnt/wslg/runtime-dir"
elif [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "/mnt/wslg/runtime-dir/${WAYLAND_DISPLAY}" ]; then
    # XDG_RUNTIME_DIR may be the systemd path which reaches the wslg socket
    # via a symlink use the direct wslg path so GTK and the compositor agree
    export XDG_RUNTIME_DIR="/mnt/wslg/runtime-dir"
fi
if [ -z "${DISPLAY:-}" ]; then
    export DISPLAY=:0
fi

# wait for the compositor socket before starting the GTK process
# a cold wsl boot triggered by clicking a windows start menu icon can
# take much longer than an already running distro so this waits up
# to one minute instead of the previous five seconds before giving
# up and trying the launch anyway
for i in $(seq 1 240); do
    [ -S "${XDG_RUNTIME_DIR:-/mnt/wslg/runtime-dir}/${WAYLAND_DISPLAY:-wayland-0}" ] && break
    sleep 0.25
done

# register display variables with the session bus activation environment
# this is the step that is missing on a cold WSL Start Menu boot and that
# a full XFCE or GNOME session does automatically on login
# without it WSLg cannot forward the app window over RDP RAIL
# the call is best effort so a missing bus does not block the launch
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    dbus-update-activation-environment --systemd \
        DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR \
        2>>"$log_file" || true
fi

# stderr of the gui goes to the launch log because the gui detaches from the terminal
exec "$native_gui" "$@" 2>>"$log_file"
